{
  "info": {
    "name": "Lama \u2014 local mock orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Restart local server before running collection. Fixed demo tokens only; not real authentication."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "demo_token",
      "value": "mock-user-1"
    },
    {
      "key": "order_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 \u2014 Create valid order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{demo_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const order = pm.response.json();",
              "  pm.collectionVariables.set(\"order_id\", String(order.id));",
              "  pm.test(\"Total is 250.00\", function () { pm.expect(order.total_amount).to.eql(\"250.00\"); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 \u2014 List my orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{demo_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
